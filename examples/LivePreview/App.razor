@using System.Diagnostics
@using Reglet
@inject IJSRuntime JS

<main>
  <section>
    <label for="source"><strong>Text</strong> &ndash; <code># Überschrift</code>, <code>## Unterüberschrift</code>, <code>- Aufzählung</code>, Leerzeile trennt Absätze</label>
    <textarea id="source" @bind="_source" @bind:event="oninput" @bind:after="ScheduleRender"></textarea>
    @if (_error is not null)
    {
      <div class="error" role="alert">@_error</div>
    }
    else
    {
      <div class="status" aria-live="polite">@_status</div>
    }
  </section>
  <section>
    <div class="preview" @ref="_preview" role="region" aria-label="PDF-Vorschau"></div>
  </section>
</main>

@code {
    private string _source = """
        # Live-Vorschau

        Dieses PDF erzeugt Reglet direkt im Browser – ohne Server. Tippe links, die Vorschau folgt.

        ## Liste

        - Erster Punkt
        - Zweiter Punkt

        Umlaute und Sonderzeichen: äöü ß €
        """;
    private string _status = "";
    private string? _error;
    private ElementReference _preview;
    private CancellationTokenSource? _pending;

    protected override Task OnAfterRenderAsync(bool firstRender) => firstRender ? RenderPdfAsync() : Task.CompletedTask;

    private async Task ScheduleRender()
    {
        _pending?.Cancel();
        _pending = new CancellationTokenSource();
        var token = _pending.Token;
        try
        {
            await Task.Delay(300, token); // debounce: one PDF per typing pause
        }
        catch (TaskCanceledException)
        {
            return;
        }
        await RenderPdfAsync();
    }

    private async Task RenderPdfAsync()
    {
        try
        {
            var watch = Stopwatch.StartNew();
            using var stream = new MemoryStream();
            await DocumentWriter.WriteAsync(Parse(_source), stream, DocumentFormat.Pdf);
            watch.Stop();
            await JS.InvokeVoidAsync("showPdf", _preview, stream.ToArray());
            _error = null;
            _status = $"PDF erzeugt in {watch.ElapsedMilliseconds} ms ({stream.Length / 1024.0:0.0} KB)";
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        StateHasChanged();
    }

    // Minimal markup: "#"/"##"/"###" headings, "- " bullets, blank line ends a paragraph.
    private static PortableDocument Parse(string source)
    {
        var builder = PortableDocument.Create().Metadata(title: "Live-Vorschau", author: "Reglet");
        var paragraph = new List<string>();
        var bullets = new List<string>();

        void Flush()
        {
            if (paragraph.Count > 0) builder.Paragraph(string.Join(" ", paragraph));
            if (bullets.Count > 0) builder.BulletList([.. bullets]);
            paragraph.Clear();
            bullets.Clear();
        }

        foreach (var raw in source.Split('\n'))
        {
            var line = raw.Trim();
            var level = line.Length - line.TrimStart('#').Length;
            if (level is >= 1 and <= 3 && line.Length > level && line[level] == ' ')
            {
                Flush();
                builder.Heading(line[(level + 1)..].Trim(), level);
            }
            else if (line.StartsWith("- "))
            {
                if (paragraph.Count > 0) Flush();
                bullets.Add(line[2..].Trim());
            }
            else if (line.Length == 0)
            {
                Flush();
            }
            else
            {
                if (bullets.Count > 0) Flush();
                paragraph.Add(line);
            }
        }
        Flush();
        return builder.Build();
    }
}
